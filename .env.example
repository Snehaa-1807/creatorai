# ============================================
# CreatorAI - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-nextauth-key-change-this

# --- MongoDB ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/creatorai?retryWrites=true&w=majority

# --- Groq AI API ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Razorpay Payments ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- Stripe (optional, replaced by Razorpay) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
